{
  "name": "Job Tracker",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const subject = item.json.Subject || \"\";\n  const snippet = item.json.snippet || \"\";\n  const emailId = item.json.id || \"\";\n  const date = item.json.internalDate || \"\";\n  const from = item.json.From || \"\";\n\n  // Skip non-job emails\n  const jobKeywords = [\"hiring\", \"job\", \"position\", \"role\", \"opportunity\", \"career\", \"apply\", \"helpdesk\", \"administrator\", \"technician\", \"analyst\", \"support\"];\n  const isJobEmail = jobKeywords.some(k => subject.toLowerCase().includes(k) || snippet.toLowerCase().includes(k));\n  \n  if (!isJobEmail) continue;\n\n  // Determine source\n  const source = from.includes(\"indeed\") ? \"Indeed\" : \"LinkedIn\";\n\n  // Parse subject\n  let jobTitle = subject;\n  let company = \"Unknown\";\n\n  if (source === \"Indeed\") {\n    const parts = subject.split(\" @ \");\n    jobTitle = parts[0]?.trim() || subject;\n    company = parts[1]?.trim() || \"Unknown\";\n  } else {\n    jobTitle = subject.replace(/:\\s.+hiring$/, \"\").trim();\n    const companyMatch = subject.match(/:\\s(.+?)\\s(and|is|are)\\s/);\n    company = companyMatch ? companyMatch[1].trim() : \"See listing\";\n  }\n\n  results.push({\n    json: {\n      emailId,\n      jobTitle,\n      company,\n      snippet: snippet.replace(/͏/g, \"\").trim(),\n      date: new Date(parseInt(date)).toISOString(),\n      source\n    }\n  });\n}\n\nreturn results;"
      },
